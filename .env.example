# Bitget API 配置示例
# 请复制此文件为 .env 并填入您的真实API凭证

# 实盘API凭证（生产环境）
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
API_PASSPHRASE=your_passphrase_here

# 模拟盘API凭证（测试环境）
PAPER_API_KEY=your_paper_api_key_here
PAPER_API_SECRET=your_paper_api_secret_here
PAPER_API_PASSPHRASE=your_paper_passphrase_here

# 环境配置
# 设置为 true 使用模拟盘，false 使用实盘
PAPER_TRADING=true

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info

# 注意事项：
# 1. Bitget没有传统意义的沙盒环境，但有模拟盘功能
# 2. 模拟盘需要单独申请API凭证
# 3. 请确保API权限包含：读取、交易（如需要）
# 4. 建议先在模拟盘环境测试